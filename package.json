    "@typescript-eslint/parser": "7.18.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~54.0.1",
    "expo-image-picker": "~16.1.4",
    "expo-status-bar": "~2.2.3",
    "express": "^5.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-svg": "^15.14.0",
    "react-native-web": "^0.20.0",
    "typescript-eslint": "^8.39.1"
